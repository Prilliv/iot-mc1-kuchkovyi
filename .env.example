# Скопіюйте у .env:  ./scripts/make-env.sh  (згенерує випадкові паролі)
# Файл .env у git НЕ потрапляє.
HOST_UID=1000
HOST_GID=1000
OPENHAB_TAG=4.3.0
BROKER_BIND=127.0.0.1

# Паролі MQTT-користувачів: один користувач = один пристрій
